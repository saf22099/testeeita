rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function mesaDoc(id) { return get(/databases/$(database)/documents/mesas/$(id)); }
    function mesaExiste(id) { return exists(/databases/$(database)/documents/mesas/$(id)); }
    function ehMestre(id) { return mesaDoc(id).data.gm == request.auth.uid; }
    function ehMembro(id) { return exists(/databases/$(database)/documents/mesas/$(id)/membros/$(request.auth.uid)); }

    // Dados particulares de cada conta: escudo do mestre, conteúdo customizado,
    // lista de campanhas em que joga.
    match /users/{uid}/{doc=**} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Perfil público (apelido e foto)
    match /perfis/{uid} {
      allow read: if logado();
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 30
        && (!('foto' in request.resource.data)
            || (request.resource.data.foto is string && request.resource.data.foto.size() < 200000));
    }

    // Campanhas: o código é o ID do documento
    match /mesas/{mesaId} {
      function mesaValida() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.get('descricao', '').size() <= 1000
          && d.get('foto', '').size() < 300000;
      }
      allow get: if logado();                                          // jogador confere o código / convite
      allow list: if logado() && resource.data.gm == request.auth.uid; // mestre lista só as dele
      allow create: if logado() && request.resource.data.gm == request.auth.uid && mesaValida();
      allow update: if logado() && resource.data.gm == request.auth.uid
                    && request.resource.data.gm == resource.data.gm && mesaValida();
      allow delete: if logado() && resource.data.gm == request.auth.uid;

      // Participantes. Entrada livre: a pessoa entra sozinha.
      // Entrada com aprovação: só o mestre adiciona (aceitando o pedido).
      match /membros/{uid} {
        allow read: if logado() && (request.auth.uid == uid || ehMestre(mesaId) || ehMembro(mesaId));
        allow create: if logado() && (
          (request.auth.uid == uid && mesaDoc(mesaId).data.get('entrada', 'aberta') != 'aprovacao')
          || ehMestre(mesaId));
        allow update: if logado() && (request.auth.uid == uid || ehMestre(mesaId));
        allow delete: if logado() && (request.auth.uid == uid || ehMestre(mesaId));
      }

      // Pedidos para entrar (campanhas com aprovação)
      match /pedidos/{uid} {
        allow read: if logado() && (request.auth.uid == uid || ehMestre(mesaId));
        allow create, update: if logado() && request.auth.uid == uid && mesaExiste(mesaId);
        allow delete: if logado() && (request.auth.uid == uid || ehMestre(mesaId));
      }
    }

    // Fichas: o dono, o mestre da campanha em que ela está e, se o mestre
    // liberar, os outros jogadores da campanha (lista "leitores", só leitura).
    match /chars/{charId} {
      allow read: if logado() && (resource.data.owner == request.auth.uid
                               || resource.data.mesaGm == request.auth.uid
                               || request.auth.uid in resource.data.get('leitores', []));

      allow create: if logado()
                    && request.resource.data.owner == request.auth.uid
                    && charId.matches(request.auth.uid + '_.*');

      // O dono edita tudo. O mestre pode editar (dano, PE, leitores etc.) sem trocar
      // o dono nem mudar a ficha de campanha, mas pode tirá-la da campanha dele.
      allow update: if logado()
                    && request.resource.data.owner == resource.data.owner
                    && (resource.data.owner == request.auth.uid
                        || (resource.data.mesaGm == request.auth.uid
                            && ((request.resource.data.mesaId == resource.data.mesaId
                                 && request.resource.data.mesaGm == resource.data.mesaGm)
                                || (request.resource.data.mesaId == ''
                                    && request.resource.data.mesaGm == ''))));

      allow delete: if logado() && resource.data.owner == request.auth.uid;
    }
  }
}
